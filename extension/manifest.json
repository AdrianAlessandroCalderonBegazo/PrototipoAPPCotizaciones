{
  "manifest_version": 3,
  "name": "ICR Autollenado SUNAT",
  "short_name": "ICR SUNAT",
  "version": "1.0.0",
  "description": "Rellena el portal SUNAT SOL con la boleta o factura preparada en ICR ERP. Nunca pulsa «Emitir» ni guarda tu clave SOL.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "background": { "service_worker": "fondo.js" },
  "content_scripts": [
    {
      "matches": ["https://erp.icrenergy.tech/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["erp.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.sunat.gob.pe/*"],
      "js": ["selectores.js", "sunat.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "ICR Autollenado SUNAT" }
}

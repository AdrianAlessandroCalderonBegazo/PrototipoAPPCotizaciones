# HTTPS automático (Let's Encrypt) para cada subdominio. DOMINIO viene del .env
# (por ejemplo icrenergy.tech). Los registros DNS tipo A de cotizador., app.,
# api., finanzas. y erp. deben apuntar a la IP del VPS.

(seguridad) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Ninguna otra página puede mostrar nuestras apps dentro de un recuadro (evita engaños tipo «clickjacking»)
		Content-Security-Policy "frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
		-Server
	}
}

# La app (PWA): archivos estáticos + la API en /api (misma dirección, sin CORS)
cotizador.{$DOMINIO} {
	import seguridad
	request_body {
		max_size 10MB
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /uploads/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/web
		@estaticos path *.js *.wasm *.png *.jpg *.json *.otf *.ttf *.woff2
		header @estaticos Cache-Control "public, max-age=86400"
		header /index.html Cache-Control "no-cache"
		header /flutter_service_worker.js Cache-Control "no-cache"
		header /version.json Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Vista general: la API sirve también la página (y /api). Finanzas va por /api-caja (la pestaña Finanzas del portal).
app.{$DOMINIO} {
	import seguridad
	request_body {
		max_size 12MB
	}
	handle /api-caja/* {
		reverse_proxy finanzas-api:8787
	}
	handle {
		reverse_proxy api:3000
	}
}

# La API sola (para el APK u otras apps)
api.{$DOMINIO} {
	import seguridad
	request_body {
		max_size 10MB
	}
	reverse_proxy api:3000
}

# Finanzas (Caja ICR: gastos, capturas, ventas, historial, reportes y «Preguntar»): la PWA en el mismo origen que sus APIs (sin CORS).
# Es una app en línea: nada se guarda para usar sin internet, por eso index.html y sw.js nunca se quedan en caché.
finanzas.{$DOMINIO} {
	import seguridad
	request_body {
		max_size 12MB
	}
	# Historial de la caja diaria y la caja chica anteriores (API de Finanzas 1).
	handle /api-caja/* {
		reverse_proxy finanzas-api:8787
	}
	# Caja ICR, ingreso y «Preguntar»: la API principal, con la misma sesión.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/finanzas
		header /_expo/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		header /manifest.webmanifest Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# ERP ICR: la app web (React) + la API principal en /api y los archivos subidos en /uploads (mismo origen, sin CORS).
# /api-caja va a la API de Finanzas (fotos de recibos de la caja anterior, en los proyectos antiguos; misma sesión).
# Los archivos con huella en el nombre (/assets/*) se guardan en caché un año; index.html nunca.
erp.{$DOMINIO} {
	import seguridad
	request_body {
		max_size 12MB
	}
	handle /api-caja/* {
		reverse_proxy finanzas-api:8787
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /uploads/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/erp
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# ---------------------------------------------------------------------------------------------------------
# Relay (aplicativo «on the side», otro proyecto que comparte este servidor). NO BORRAR ESTE BLOQUE:
# cada despliegue de icr reemplaza el Caddyfile del VPS por este archivo, así que si Relay no está aquí se cae.
# Los contenedores de Relay (relay-web) deben estar en la misma red de Docker que Caddy.
# ---------------------------------------------------------------------------------------------------------
# Relay (atleta y coach) → contenedor relay-web
atleta.adriancalderonbegazo.site {
	reverse_proxy relay-web:8081
}
coach.adriancalderonbegazo.site {
	reverse_proxy relay-web:8082
}

# Copia este archivo como ".env" (cp .env.example .env) y completa los valores.
# El archivo .env NO se sube a GitHub ni se comparte: tiene las claves.

# Tu dominio (sin "www"). Debe tener registros DNS tipo A para cotizador, app, api, finanzas, finanza y erp.
DOMINIO=icrenergy.tech
# Clave de la base de datos (una larga y única)
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# Primer administrador (solo se usa la primera vez que arranca). Cámbiale la clave desde la vista general.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave

# Clave para editar cotizaciones, requerimientos y salidas ya registrados (la de siempre es 1234; mejor cámbiala)
CLAVE_EDICION=1234

# Quién puede qué en Finanzas (y en todo lo demás) ya no va aquí: se cambia en ERP › Configuración › Matriz de permisos.

# --- ERP: integraciones (opcionales; sin ellas el ERP funciona y las marca «no configurado») -----------------------
# IA local (Ollama en el VPS, contenedor «ollama»). Los modelos se descargan con ./scripts/instalar_ia.sh.
#OLLAMA_URL=http://ollama:11434     # ya viene así por defecto (contenedor «ollama» del docker-compose)
#OLLAMA_MODELO=qwen3:4b             # modelo de chat (también se cambia en ERP › Configuración › Inteligencia artificial)
#OLLAMA_EMBED=bge-m3                # modelo de búsqueda por significado (multilingüe)
# Victron VRM: token de acceso personal (VRM → Preferencias → Integraciones → Tokens de acceso). Nunca lo pegues en un chat.
#VRM_TOKEN=
# Consulta de RUC (SUNAT) y DNI (RENIEC) en Facturación: token de un proveedor (por defecto decolecta.com; con otro proveedor,
# pon sus direcciones con {numero} donde va el documento). Sin token, el nombre del cliente se escribe a mano.
#CONSULTA_DOC_TOKEN=
#CONSULTA_RUC_URL=https://api.decolecta.com/v1/sunat/ruc?numero={numero}
#CONSULTA_DNI_URL=https://api.decolecta.com/v1/reniec/dni?numero={numero}

# --- Finanzas 2 (versión de prueba, finanza.TUDOMINIO) ----------------------------------------------
# Aviso automático de reposición por Telegram (opcional; sin token no se manda nada y la app igual lo muestra).
# Se crea un bot con @BotFather y se pega aquí el token que entrega.
#TELEGRAM_BOT_TOKEN=

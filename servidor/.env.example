# Copia este archivo como ".env" (cp .env.example .env) y completa los valores.
# El archivo .env NO se sube a GitHub ni se comparte: tiene las claves.

# Tu dominio (sin "www"). Debe tener registros DNS tipo A para cotizador, app, api y finanzas.
DOMINIO=icrenergy.tech
# Clave de la base de datos (una larga y única)
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# Primer administrador (solo se usa la primera vez que arranca). Cámbiale la clave desde la vista general.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave

# Clave para editar cotizaciones, requerimientos y salidas ya registrados (la de siempre es 1234; mejor cámbiala)
CLAVE_EDICION=1234
